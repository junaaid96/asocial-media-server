# Neon Postgres (pooled connection string). Local dev can point at a local Postgres.
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# Secret used to sign login tokens. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me

# Neon Object Storage (S3-compatible). Create a credential with storage:read + storage:write.
AWS_ENDPOINT_URL_S3=https://br-xxxx.storage.c-6.us-east-2.aws.neon.tech
AWS_ACCESS_KEY_ID=nak_live_...
AWS_SECRET_ACCESS_KEY=nsk_live_...
AWS_REGION=us-east-2
STORAGE_BUCKET=asocial-media-uploads

# Comma-separated list of browser origins allowed to call the API.
CLIENT_ORIGINS=http://localhost:5173

PORT=5000
